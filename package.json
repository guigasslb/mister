{
  "name": "mister",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:sub11": "tsx --env-file=.env prisma/seed-sub11-pg.ts",
    "db:studio": "prisma studio",
    "db:seed:comunicacao": "tsx prisma/data-migrations/f7_seed_comunicacao.ts",
    "db:migrate:cap-admin": "tsx --env-file=.env prisma/data-migrations/reconciliar_capacidades_administrador.ts",
    "db:seed:sle": "tsx --env-file=.env prisma/data-migrations/seed_sport_lisboa_evora.ts",
    "db:seed:sle-extra": "tsx --env-file=.env prisma/data-migrations/seed_sport_lisboa_evora_extra.ts",
    "db:seed:sle-fix": "tsx --env-file=.env prisma/data-migrations/seed_sport_lisboa_evora_fix.ts",
    "db:seed-exercicios-goncalo": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed-exercicios-goncalo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "^0.35.0",
    "nanoid": "^3.3.17"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "googleapis": "^174.0.1",
    "lucide-react": "^0.469.0",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.22",
    "pg": "^8.23.0",
    "postcss": "^8.5.25",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
