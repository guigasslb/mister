// prisma/schema.prisma
// Mister — Modelo de dados (bíblia: docs/Mister_Spec_v7.md)

generator client {
  provider      = "prisma-client-js"
  // "native" para dev local; "rhel-openssl-3.0.x" para o runtime serverless (Vercel).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// CLUBE E UTILIZADORES
// ─────────────────────────────────────────────

model Clube {
  id            String   @id @default(cuid())
  nome          String
  // 🔁 v7 (§3.1): true = clube técnico invisível que suporta a licença Individual.
  clubeTecnico  Boolean  @default(false)
  // §12.1: cor Mister por defeito (contract v6 — default aplica-se só a novos registos).
  corPrimaria   String   @default("#F0531E")
  corSecundaria String   @default("#FFD700")
  logoUrl       String?
  morada        String?
  email         String?
  telefone      String?
  criadoEm      DateTime @default(now())

  // F10 — flag de onboarding concluído (assistente de arranque).
  onboardingConcluido Boolean @default(false)

  membros       MembroClube[]
  perfis        Perfil[]
  epocas        Epoca[]
  // 🔁 v7 (§3.1.1): secções (modalidades) do clube.
  seccoes       Seccao[]
  escaloes      Escalao[]
  exercicios    Exercicio[]
  metricas      MetricaConfig[]
  habilidades   Habilidade[]
  reunioes      Reuniao[]
  subcategorias SubcategoriaExercicio[]
  atletas       Atleta[]

  // F3 (expand): propriedade explícita e partilha da biblioteca de exercícios.
  exerciciosProprietario Exercicio[]              @relation("ExercicioClube")
  partilhasExercicio     PartilhaExercicioClube[]
  modelosSessao          ModeloSessao[]

  // F7 (M11): templates de comunicação personalizados do clube.
  modelosComunicacao ModeloComunicacao[]

  // F11 (§3.11): licença de clube (se real). Titular exclusivo (clubeId @unique em Licenca).
  licenca Licenca? @relation("LicencaClube")

  // P1.5: constraints de FK em falta — relações inversas para dados scoped ao clube.
  planeamentos            Planeamento[]
  competicoes             Competicao[]
  observacoesAdversario   ObservacaoAdversario[]
  modelosJogoProprietario ModeloJogo[]           @relation("ModeloJogoClube")

  // P2.1 (§3.15/§8.19): lembretes/tarefas persistidos do clube.
  lembretes Lembrete[]

  // Fase 31 (§3.5/§8.8.1): planos semanais de treino do clube.
  planosSemanais PlanoSemanal[]

  // Mano-a-Mano (§3.16): competições de duelos 1×1 do clube e clubes externos criados.
  competicoesManoMano   CompeticaoManoMano[]
  clubesExternosCriados ClubeExterno[]
}

// ─────────────────────────────────────────────
// REUNIÕES
// ─────────────────────────────────────────────

model Reuniao {
  id             String        @id @default(cuid())
  clubeId        String
  clube          Clube         @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  ambito         AmbitoReuniao @default(CLUBE)
  escalaoId      String? // obrigatório (lógico) se ambito = ESCALAO
  titulo         String
  data           DateTime
  participantes  String?       @db.Text
  ordemTrabalhos String?       @db.Text
  ata            String?       @db.Text
  // Afixada no Dashboard/Início: quando true, a reunião fica sempre visível no
  // painel de arranque (independentemente da data). Aditivo, default false.
  afixada        Boolean       @default(false)
  // Criador da reunião. Nullable com SetNull: se o utilizador for apagado, a
  // reunião fica sem criador mas NÃO é apagada (o histórico preserva-se).
  criadorId      String?
  criador        Utilizador?   @relation("ReuniaoCriador", fields: [criadorId], references: [id], onDelete: SetNull)
  criadoEm       DateTime      @default(now())

  // F8 (§3.12): id do evento correspondente no Google Calendar (idempotência da sincronização).
  googleEventId String?

  @@index([clubeId])
  @@index([criadorId])
}

enum AmbitoReuniao {
  CLUBE
  ESCALAO
}

// ─────────────────────────────────────────────
// COMUNICAÇÃO (gerador de texto para WhatsApp)
// ─────────────────────────────────────────────

// Template de comunicação. A app GERA texto formatado (bíblia §3.9, §8.12);
// não envia nem integra APIs de mensagens.
//
// O seed instala um modelo global por tipo (clubeId = null, origemSeed = true),
// disponível a todos os clubes. Um clube pode criar a sua variante personalizada
// (clubeId preenchido), que prevalece sobre a global para esse tipo.
model ModeloComunicacao {
  id       String          @id @default(cuid())
  tipo     TipoComunicacao
  nome     String // ex: "Convocatória padrão"
  template String          @db.Text // texto com placeholders ex: {{nomeAtleta}}, {{data}}, {{local}}

  // null = seed global (disponível a todos); preenchido = personalizado pelo clube
  clubeId String?
  clube   Clube?  @relation(fields: [clubeId], references: [id], onDelete: Cascade)

  origemSeed Boolean @default(false) // true = foi instalado pelo seed

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([clubeId, tipo]) // um modelo por tipo por clube (NOTA: em Postgres, NULLs são distintos — a unicidade dos globais é garantida pelo upsert idempotente do seed)
  @@index([tipo])
  @@index([clubeId])
}

enum TipoComunicacao {
  CONVOCATORIA
  CANCELAMENTO
  MUDANCA_HORARIO
  MUDANCA_LOCAL
  RESULTADO
  AVISO_GERAL
  CALENDARIO_MENSAL
}

// O utilizador existe independentemente de qualquer clube (modo individual + portabilidade).
model Utilizador {
  id           String   @id @default(cuid())
  nome         String
  email        String   @unique
  passwordHash String
  telefone     String?
  // Admin de plataforma (backoffice /admin). Persistido na BD (fonte de verdade),
  // NÃO em variável de ambiente. Um admin é um operador do produto Mister,
  // independente de qualquer papel de clube (não tem MembroClube). Ver §21.1 e
  // `lib/admin-guard.ts`. Aditivo, default false (ninguém é admin por omissão).
  isAdmin      Boolean  @default(false)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  membros           MembroClube[]
  sessoesCriadas    Sessao[]      @relation("SessaoCriador")
  jogosCriados      Jogo[]        @relation("JogoCriador")
  exerciciosCriados Exercicio[]   @relation("ExercicioCriador")
  modelosJogo       ModeloJogo[]  @relation("ModeloJogoAutor")

  // F3 (expand): autoria humana explícita, independente do clube.
  exerciciosAutor    Exercicio[]    @relation("ExercicioAutor")
  modelosSessaoAutor ModeloSessao[] @relation("ModeloSessaoAutor")

  // F8 (§3.12): integração com calendário externo (Google Calendar) do treinador.
  integracaoCalendario IntegracaoCalendario?

  // F11 (§3.11): licença Individual (se ativa) e carteira de crédito (🎒 portátil).
  licencaIndividual Licenca?  @relation("LicencaIndividual")
  carteira          Carteira?

  // P2.1 (§3.15/§8.19): lembretes criados e lembretes recebidos como destinatário.
  // NOTA: a pessoa é o `Utilizador` (o `Perfil` no modelo é um pacote de
  // capacidades/papel, não uma pessoa) — o estado `visto` é por pessoa.
  lembretesCriados   Lembrete[]             @relation("LembreteCriadoPor")
  lembretesRecebidos LembreteDestinatario[] @relation("LembreteDestinatario")

  // P2.4 (§8.17): histórico de carreira do treinador (portátil, pertence à pessoa,
  // não ao clube — âncora do "o que crias é teu para toda a carreira", §17.3).
  registosCarreira RegistoCarreira[]

  // Reuniões criadas por este utilizador. SetNull ao apagar o utilizador
  // (a reunião preserva-se sem criador).
  reunioesCriadas Reuniao[] @relation("ReuniaoCriador")

  // Fase 31 (§3.5/§8.8.1): planos semanais criados por este utilizador.
  planosSemanaisComoCriador PlanoSemanal[] @relation("PlanoSemanalCriador")

  // Mano-a-Mano (§3.16): competições de duelos 1×1 criadas por este utilizador.
  competicoesManoManoCriadas CompeticaoManoMano[]
}

// ─────────────────────────────────────────────
// P2.4 — PERFIL DO TREINADOR / HISTÓRICO DE CARREIRA (§8.17)
// ─────────────────────────────────────────────

// Registo de uma passagem na carreira do treinador (clube/escalão/épocas/conquistas).
// Pertence ao Utilizador (a pessoa), é portátil e independente de qualquer clube:
// o treinador pode ter treinado em clubes fora do sistema, por isso `clube` é texto
// livre. Alimenta o perfil profissional (diferenciador da licença Individual, §17.3).
model RegistoCarreira {
  id           String     @id @default(cuid())
  utilizadorId String
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  clube        String // nome do clube (texto livre — pode ter treinado fora do sistema)
  escalao      String // ex. "Seniores", "Sub-17"
  epocaInicio  String // ex. "2022/2023"
  epocaFim     String? // null = ainda em curso
  conquistas   String? // texto livre — ex. "Campeão Distrital"
  notas        String?
  ordem        Int        @default(0) // para ordenação manual
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([utilizadorId])
}

// ─────────────────────────────────────────────
// MODELO DE JOGO E QUADRO TÁTICO
// ─────────────────────────────────────────────

// Metodologia do treinador. Propriedade determinada pela licença (secção 4.2). Reutiliza o editor de campo.
model ModeloJogo {
  id                  String              @id @default(cuid())
  autorId             String
  autor               Utilizador          @relation("ModeloJogoAutor", fields: [autorId], references: [id])
  proprietario        PropriedadeConteudo @default(CLUBE)
  clubeProprietarioId String?
  // P1.5: FK explícita. Nullable (só preenchido quando proprietario = CLUBE);
  // SetNull segue o mesmo padrão de escalaoId/epocaId — se o clube for removido,
  // o modelo degrada para metodologia pessoal/portátil do autor (conteúdo preservado).
  clubeProprietario   Clube?              @relation("ModeloJogoClube", fields: [clubeProprietarioId], references: [id], onDelete: SetNull)
  nome                String
  momento             MomentoJogo
  principios          String?             @db.Text
  diagrama            Json?
  criadoEm            DateTime            @default(now())
  atualizadoEm        DateTime            @updatedAt

  // ── F4 (M8) — documento vivo por escalão/época ────────────────────────────
  // Ambos nullable: null/null = metodologia genérica portátil do treinador
  // (biblioteca pessoal, viaja com ele). Preenchidos = documento da equipa.
  escalaoId String?
  escalao   Escalao? @relation("ModeloJogoEscalao", fields: [escalaoId], references: [id], onDelete: SetNull)
  epocaId   String?
  epoca     Epoca?   @relation("ModeloJogoEpoca", fields: [epocaId], references: [id], onDelete: SetNull)

  // Subprincípios do momento (array JSON de strings ou objectos {titulo, detalhe}).
  subprincipios Json?

  @@index([clubeProprietarioId])
  @@index([autorId])
  @@index([clubeProprietarioId, escalaoId, epocaId])
  @@index([escalaoId])
  @@index([epocaId])
}

enum MomentoJogo {
  ORG_OFENSIVA
  ORG_DEFENSIVA
  TRANS_OFENSIVA
  TRANS_DEFENSIVA
  BOLAS_PARADAS
}

// Quadro tático específico de um jogo (do clube).
model QuadroTatico {
  id       String           @id @default(cuid())
  jogoId   String
  jogo     Jogo             @relation(fields: [jogoId], references: [id], onDelete: Cascade)
  nome     String
  tipo     TipoQuadroTatico @default(GERAL) // F4 (M8): GERAL | BOLA_PARADA
  diagrama Json?
  notas    String?          @db.Text

  @@index([jogoId])
}

// Natureza do quadro tático (bíblia §3.6).
enum TipoQuadroTatico {
  GERAL
  BOLA_PARADA
}

// Adesão utilizador↔clube. REGRA (lógica): no máximo UMA adesão ATIVA por utilizador.
/// Garante no máximo uma adesão ATIVO por utilizador — constraint anti-duplicado atómica.
/// Aplicada por um índice único PARCIAL em SQL (MembroClube_utilizadorId_ativo_unique,
/// WHERE estado = 'ATIVO'), porque o Prisma ORM não modela índices parciais. Ver a
/// migração 20260824160000_add_unique_membro_ativo_por_utilizador. Fecha a janela TOCTOU
/// de criarClube (§5.4): dois pedidos concorrentes não conseguem criar dois clubes.
model MembroClube {
  id           String       @id @default(cuid())
  utilizadorId String
  utilizador   Utilizador   @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  clubeId      String
  clube        Clube        @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  perfilId     String
  perfil       Perfil       @relation(fields: [perfilId], references: [id])
  estado       EstadoMembro @default(ATIVO)
  dataEntrada  DateTime     @default(now())
  dataSaida    DateTime?

  // Overrides de capacidades sobre o perfil base (F0). Chaves de capacidade (secção 6 da bíblia).
  capacidadesExtra     String[] @default([])
  capacidadesRevogadas String[] @default([])

  atribuicoes AtribuicaoEscalao[]
  // 🔁 v7 (§3.1.1): secções que este membro coordena (scope de secção).
  seccoes     MembroSeccao[]

  // GAP-P2-15: presenças marcadas por este membro (rastreio de autor).
  presencasMarcadas Presenca[] @relation("PresencasMarcadas")

  // Mano-a-Mano (§3.16): resultados de duelos 1×1 registados por este membro.
  duelosRegistados MatchManoMano[]

  @@unique([utilizadorId, clubeId])
  @@index([clubeId])
  @@index([utilizadorId])
  @@index([perfilId])
}

enum EstadoMembro {
  ATIVO
  INATIVO
  CONVIDADO
}

// Perfil = pacote configurável de capacidades + âmbito. Por clube, com modelos de arranque editáveis.
model Perfil {
  id          String       @id @default(cuid())
  clubeId     String
  clube       Clube        @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  nome        String
  descricao   String?
  ambito      AmbitoPerfil @default(PROPRIOS_ESCALOES)
  capacidades String[] // chaves de capacidade (ver secção 6 da bíblia)
  sistema     Boolean      @default(false)
  criadoEm    DateTime     @default(now())

  membros MembroClube[]

  @@index([clubeId])
}

enum AmbitoPerfil {
  TODO_CLUBE
  // 🔁 v7 (§6.3): todos os escalões de uma secção (Coordenador de Secção).
  SECCAO
  PROPRIOS_ESCALOES
}

// Escalões que um membro gere (quando o perfil tem âmbito PROPRIOS_ESCALOES).
model AtribuicaoEscalao {
  id            String      @id @default(cuid())
  membroClubeId String
  membroClube   MembroClube @relation(fields: [membroClubeId], references: [id], onDelete: Cascade)
  escalaoId     String
  escalao       Escalao     @relation(fields: [escalaoId], references: [id], onDelete: Cascade)

  @@unique([membroClubeId, escalaoId])
  @@index([escalaoId])
}

// ─────────────────────────────────────────────
// ÉPOCA
// ─────────────────────────────────────────────

model Epoca {
  id         String   @id @default(cuid())
  nome       String // ex: "2025/26"
  dataInicio DateTime
  dataFim    DateTime
  ativa      Boolean  @default(false) // época default ao entrar
  clubeId    String
  clube      Clube    @relation(fields: [clubeId], references: [id])
  criadoEm   DateTime @default(now())

  sessoes       Sessao[]
  jogos         Jogo[]
  progressos    ProgressoHabilidade[]
  planeamentos  Planeamento[]
  competicoes   Competicao[]
  participacoes AtletaEscalao[]
  modelosJogo   ModeloJogo[]          @relation("ModeloJogoEpoca")

  // Fase 31 (§3.5/§8.8.1): planos semanais de treino desta época.
  planosSemanais PlanoSemanal[]

  // Mano-a-Mano (§3.16): competições de duelos 1×1 desta época.
  competicoesManoMano CompeticaoManoMano[]

  @@index([clubeId])
}

// ─────────────────────────────────────────────
// SECÇÕES (multi-desporto — 🔁 v7, §3.1.1)
// ─────────────────────────────────────────────

// A modalidade de uma secção.
enum Modalidade {
  FUTSAL
  FUTEBOL
}

// Papel de um membro numa secção (extensível no futuro — §3.1.1).
enum PapelSeccao {
  COORDENADOR
}

// Subdivisão do clube por modalidade. Âncora da modalidade (§1.7.1): cada escalão
// pertence a uma secção; a modalidade de tudo o resto deriva daí. Um clube tem no
// máximo UMA secção por modalidade. Criada automaticamente ao criar o primeiro
// escalão da modalidade (§8.1.1). Backfill: uma secção FUTSAL por clube (Apêndice C).
model Seccao {
  id         String     @id @default(cuid())
  clubeId    String
  clube      Clube      @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  modalidade Modalidade
  nome       String? // "Futsal" | "Futebol" | nome custom; fallback = rótulo da modalidade
  criadoEm   DateTime   @default(now())

  escaloes Escalao[]
  membros  MembroSeccao[]

  @@unique([clubeId, modalidade])
  @@index([clubeId])
}

// Vínculo membro↔secção com scope de coordenação (Coordenador de Secção — §6.9).
model MembroSeccao {
  id            String      @id @default(cuid())
  seccaoId      String
  seccao        Seccao      @relation(fields: [seccaoId], references: [id], onDelete: Cascade)
  membroClubeId String
  membroClube   MembroClube @relation(fields: [membroClubeId], references: [id], onDelete: Cascade)
  papel         PapelSeccao @default(COORDENADOR)
  criadoEm      DateTime    @default(now())

  @@unique([seccaoId, membroClubeId])
  @@index([membroClubeId])
}

// ─────────────────────────────────────────────
// ESCALÕES E ATLETAS
// ─────────────────────────────────────────────

model Escalao {
  id                       String   @id @default(cuid())
  nome                     String
  idadeMin                 Int?
  idadeMax                 Int?
  ordem                    Int      @default(0)
  visivelOutrosTreinadores Boolean  @default(true)
  clubeId                  String
  clube                    Clube    @relation(fields: [clubeId], references: [id])
  // 🔁 v7 (§3.2): cada escalão pertence a uma secção (modalidade).
  // Fase expand: nullable; contract (NOT NULL) após backfill (Apêndice C).
  seccaoId                 String?
  seccao                   Seccao?  @relation(fields: [seccaoId], references: [id])
  criadoEm                 DateTime @default(now())

  sessoes       Sessao[]
  jogos         Jogo[]
  atribuicoes   AtribuicaoEscalao[]
  planeamentos  Planeamento[]
  competicoes   Competicao[]
  participacoes AtletaEscalao[]
  presencas     Presenca[]          @relation("PresencaEscalao")
  modelosJogo   ModeloJogo[]        @relation("ModeloJogoEscalao")

  // Fase 31 (§3.5/§8.8.1): planos semanais de treino deste escalão.
  planosSemanais PlanoSemanal[]

  // Mano-a-Mano (§3.16): competições de duelos 1×1 deste escalão.
  competicoesManoMano CompeticaoManoMano[]

  @@index([clubeId])
  @@index([seccaoId])
}

model Atleta {
  id             String    @id @default(cuid())
  nome           String
  dataNascimento DateTime?
  posicoes       Posicao[] // um atleta pode ter várias posições
  numero         Int?
  observacoes    String?   @db.Text
  fotoUrl        String? // por URL (sem upload por agora)
  ativo          Boolean   @default(true)
  // Inscrição federativa/no clube (secção 8 — plantel): distingue quem já está
  // formalmente inscrito de quem falta inscrever. Independente de `ativo` (um
  // atleta ativo pode ainda estar por inscrever). Default false: nasce por inscrever.
  inscrito       Boolean   @default(false)
  dataIngresso   DateTime? // para a taxa de presença (secção 10); fallback = criadoEm

  // Dados do encarregado de educação (RGPD — minimização).
  encarregadoNome     String?
  encarregadoContacto String?
  encarregadoEmail    String?

  // Clube do atleta (contract v6 — §3.2): o atleta pertence ao clube, transversal
  // às épocas e às modalidades. As participações vivem em AtletaEscalao.
  clubeId String
  clube   Clube  @relation(fields: [clubeId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  presencas             Presenca[]
  convocatorias         Convocatoria[]
  estatisticas          EstatisticaAtleta[]
  progressos            ProgressoHabilidade[]
  consentimentos        Consentimento[]
  participacoes         AtletaEscalao[]
  // P1.5: eventos de jogo (ao vivo) associados ao atleta.
  eventosJogo           EventoJogo[]
  // P4.8 (§8.20): RPE individual reportado pelo atleta por sessão.
  rpesAtletas           RpeAtleta[]
  // Mano-a-Mano (§3.16): participações do atleta em competições de duelos 1×1.
  participacoesManoMano ParticipanteManoMano[]

  @@index([clubeId])
  @@index([clubeId, ativo])
}

// RGPD — consentimento parental para dados de menores (secção 5.5 da bíblia).
model Consentimento {
  id                  String            @id @default(cuid())
  atletaId            String
  atleta              Atleta            @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  tipo                TipoConsentimento
  concedido           Boolean           @default(false)
  encarregadoEducacao String?
  dataConsentimento   DateTime?

  @@unique([atletaId, tipo])
  @@index([atletaId])
}

enum TipoConsentimento {
  DADOS
  IMAGEM
}

// 🔁 v7 (§3.2): posições de FUTSAL + FUTEBOL num único enum.
// GUARDA_REDES e UNIVERSAL são partilhados pelas duas modalidades.
enum Posicao {
  // Partilhados / futsal
  GUARDA_REDES
  FIXO
  ALA
  PIVO
  UNIVERSAL
  // Futebol 🥅
  DEFESA_CENTRAL
  LATERAL_DIREITO
  LATERAL_ESQUERDO
  MEDIO_DEFENSIVO
  MEDIO_CENTRO
  MEDIO_OFENSIVO
  EXTREMO_DIREITO
  EXTREMO_ESQUERDO
  AVANCADO
}

// Participação de um atleta num escalão durante uma época.
// Substitui gradualmente os campos legados escalaoId/escalaoSecundarioId do Atleta.
// Fase expand (M2): coexiste com os campos legados; backfill em M3; switch em M4.
model AtletaEscalao {
  id String @id @default(cuid())

  atletaId String
  atleta   Atleta @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  escalaoId String
  escalao   Escalao @relation(fields: [escalaoId], references: [id], onDelete: Restrict)

  epocaId String
  epoca   Epoca  @relation(fields: [epocaId], references: [id], onDelete: Restrict)

  tipo   TipoParticipacao   @default(PRINCIPAL)
  estado EstadoParticipacao @default(ATIVO)

  numero     Int?
  dataInicio DateTime  @default(now())
  dataFim    DateTime?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([atletaId, escalaoId, epocaId])
  @@index([escalaoId, epocaId, estado])
  @@index([atletaId, epocaId])
}

enum TipoParticipacao {
  PRINCIPAL
  SIMULTANEA
  OCASIONAL
}

enum EstadoParticipacao {
  ATIVO
  TRANSICAO_PERMANENTE
  INATIVO
}

// ─────────────────────────────────────────────
// EXERCÍCIOS
// ─────────────────────────────────────────────

model Exercicio {
  id                 String                       @id @default(cuid())
  nome               String
  descricao          String?                      @db.Text
  objetivo           String?                      @db.Text
  duracaoMin         Int?
  categoriaPrincipal CategoriaExercicioPrincipal?
  subcategoriaId     String?
  subcategoria       SubcategoriaExercicio?       @relation(fields: [subcategoriaId], references: [id])
  diagrama           Json? // DiagramaCampo (ver secção 11 da bíblia)
  clubeId            String
  clube              Clube                        @relation(fields: [clubeId], references: [id])
  criadorId          String
  criador            Utilizador                   @relation("ExercicioCriador", fields: [criadorId], references: [id])
  // Contract v6 (§4.2): exercício criado por um treinador é pessoal por defeito.
  proprietario       PropriedadeConteudo          @default(TREINADOR)
  // 🔁 v7 (§3.3): FUTSAL | FUTEBOL | null = genérico (filtro da biblioteca).
  modalidade         Modalidade?
  origemSeed         Boolean                      @default(false)
  criadoEm           DateTime                     @default(now())
  atualizadoEm       DateTime                     @updatedAt

  // ── F3 (fase expand) ─────────────────────────
  // Autor humano do exercício (sempre registado). Substitui semanticamente
  // criadorId, mas coexiste com ele nesta fase; backfill em M6.
  autorId String?
  autor   Utilizador? @relation("ExercicioAutor", fields: [autorId], references: [id])

  // Clube proprietário — só preenchido quando proprietario = CLUBE.
  // Coexiste com o clubeId legado nesta fase; backfill em M6.
  clubeProprietarioId String?
  clubeProprietario   Clube?  @relation("ExercicioClube", fields: [clubeProprietarioId], references: [id])

  // Parte do treino onde o exercício se aplica.
  parteTreino ParteTreino?

  // Escalão-alvo (texto livre, para filtros da biblioteca).
  escalaoAlvo String?

  sessoes        SessaoExercicio[]
  partilhasClube PartilhaExercicioClube[]
  modelosSessao  ModeloSessaoExercicio[]

  // Exercícios não são filtrados por época — a biblioteca é reutilizável entre épocas.
  @@index([clubeId])
  @@index([clubeId, categoriaPrincipal])
  @@index([subcategoriaId])
  @@index([autorId])
  @@index([clubeProprietarioId])
  @@index([parteTreino])
}

// Parte do treino (organização da biblioteca de exemplo e dos templates de sessão).
// Valores conforme a bíblia §3.3.
enum ParteTreino {
  AQUECIMENTO
  PRINCIPAL
  JOGO_REDUZIDO
  RETORNO_CALMA
}

// Toggle explícito de contribuição de um exercício para a biblioteca de um clube.
// Permite que um exercício pessoal (proprietario = TREINADOR) seja partilhado
// com um ou mais clubes sem transferir a propriedade.
model PartilhaExercicioClube {
  id          String    @id @default(cuid())
  exercicioId String
  exercicio   Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)
  clubeId     String
  clube       Clube     @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  criadoEm    DateTime  @default(now())

  @@unique([exercicioId, clubeId])
  @@index([clubeId])
}

// ─────────────────────────────────────────────
// MODELOS DE SESSÃO (templates de treino)
// ─────────────────────────────────────────────

// Sessão completa pré-construída e reutilizável (bíblia §3.4).
model ModeloSessao {
  id String @id @default(cuid())

  autorId String
  autor   Utilizador @relation("ModeloSessaoAutor", fields: [autorId], references: [id])

  // Propriedade: TREINADOR (pessoal, portátil) ou CLUBE — toggle na criação.
  proprietario PropriedadeConteudo @default(TREINADOR)

  clubeProprietarioId String?
  clubeProprietario   Clube?  @relation(fields: [clubeProprietarioId], references: [id])

  // 🔁 v7 (§3.4): FUTSAL | FUTEBOL | null = genérico.
  modalidade Modalidade?

  origemSeed     Boolean       @default(false) // template da biblioteca curada de arranque
  nome           String // ex: "Pressing defensivo, 60 min, sub-10"
  objetivoTatico String?
  faseEpoca      PeriodoEpoca? // PREPARATORIO | COMPETITIVO | TRANSICAO
  escalaoAlvo    String? // "sub-10" / faixa etária
  duracaoMin     Int?
  descricao      String?       @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  exercicios ModeloSessaoExercicio[]

  @@index([clubeProprietarioId])
  @@index([autorId])
}

model ModeloSessaoExercicio {
  id             String       @id @default(cuid())
  modeloSessaoId String
  modeloSessao   ModeloSessao @relation(fields: [modeloSessaoId], references: [id], onDelete: Cascade)
  exercicioId    String
  exercicio      Exercicio    @relation(fields: [exercicioId], references: [id], onDelete: Restrict)
  ordem          Int          @default(0)
  duracaoMin     Int?
  parteTreino    ParteTreino?
  notas          String?      @db.Text

  @@unique([modeloSessaoId, ordem])
  @@index([modeloSessaoId])
  @@index([exercicioId])
}

// Subcategoria de exercício, customizável por clube (ex: "Finalização", "1x1", "Contra-ataque").
model SubcategoriaExercicio {
  id        String                      @id @default(cuid())
  clubeId   String
  clube     Clube                       @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  nome      String
  categoria CategoriaExercicioPrincipal
  ordem     Int                         @default(0)
  sistema   Boolean                     @default(false) // instalada por seed, não apagável pelo utilizador
  criadoEm  DateTime                    @default(now())

  exercicios Exercicio[]

  @@index([clubeId, categoria])
}

// De quem é o conteúdo metodológico criado (ver secção 4.2 da bíblia).
enum PropriedadeConteudo {
  CLUBE
  TREINADOR
}

enum CategoriaExercicioPrincipal {
  ATAQUE
  DEFESA
  TRANSICAO
  BOLAS_PARADAS
  FISICO
  GUARDA_REDES
  OUTRO
}

// ─────────────────────────────────────────────
// PERIODIZAÇÃO (planos semanais/mensais)
// ─────────────────────────────────────────────

model Planeamento {
  id         String          @id @default(cuid())
  clubeId    String
  // P1.5: FK explícita para o clube proprietário do planeamento.
  clube      Clube           @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  escalaoId  String
  escalao    Escalao         @relation(fields: [escalaoId], references: [id], onDelete: Cascade)
  epocaId    String
  epoca      Epoca           @relation(fields: [epocaId], references: [id], onDelete: Cascade)
  tipo       TipoPlaneamento @default(SEMANAL)
  periodo    PeriodoEpoca?
  mesociclo  Int?
  microciclo Int?
  // §8.9.1 (decisão 2026-08-16) — Semana de trabalho (formalização opcional).
  nome       String? // nome livre da semana formalizada ("Semana do torneio", "Pré-jogo Benfica"); fallback "Semana N" ← microciclo
  modoSemana ModoSemana? // ESTRUTURADO (dias MD-X) | TEXTO_LIVRE; só quando o treinador formaliza a semana (tipo=SEMANAL). Null = não formalizada
  notaSemana String?         @db.Text // campo aberto do modo TEXTO_LIVRE
  dataInicio DateTime
  dataFim    DateTime
  objetivos  String?         @db.Text
  criadoEm   DateTime        @default(now())

  sessoes Sessao[]

  @@index([epocaId, escalaoId])
  @@index([escalaoId])
  @@index([clubeId])
}

enum TipoPlaneamento {
  SEMANAL
  MENSAL
}

// §8.9.1 — Modo de detalhe de uma SEMANA formalizada. Só se aplica a Planeamento.tipo = SEMANAL.
enum ModoSemana {
  ESTRUTURADO // usa lista MD-X (Sessao.momentoSemana)
  TEXTO_LIVRE // campo aberto (Planeamento.notaSemana)
}

enum PeriodoEpoca {
  PREPARATORIO
  COMPETITIVO
  TRANSICAO
}

// ─────────────────────────────────────────────
// PLANO SEMANAL DE TREINOS (§3.5/§8.8.1 — Fase 31)
// ─────────────────────────────────────────────

// Horário RECORRENTE de treino de um escalão numa época. A partir dos dias da
// semana configurados, o sistema GERA automaticamente as sessões da época (§8.8.1).
// As sessões geradas ligam-se ao plano (Sessao.planoSemanalId) e ao dia
// (Sessao.planoSemanalDiaId) para a propagação "esta e todas as futuras" funcionar.
// NÃO confundir com Planeamento (periodização/carga por semana — MD-X, microciclo)
// nem com ModeloSessao (conteúdo reutilizável): o plano semanal só AGENDA
// (data/hora/local/tipo); o CONTEÚDO (exercícios/presenças) vive na Sessao.
// No máximo UM plano `ativo` por (escalaoId, epocaId) — validado na aplicação.
model PlanoSemanal {
  id           String   @id @default(cuid())
  clubeId      String // scope multi-tenant (todas as queries filtram por clube)
  escalaoId    String
  epocaId      String
  nome         String? // livre; fallback = nome do escalão
  ativo        Boolean  @default(true)
  criadorId    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  clube   Clube      @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  escalao Escalao    @relation(fields: [escalaoId], references: [id], onDelete: Cascade)
  epoca   Epoca      @relation(fields: [epocaId], references: [id], onDelete: Cascade)
  criador Utilizador @relation("PlanoSemanalCriador", fields: [criadorId], references: [id])

  dias    PlanoSemanalDia[]
  sessoes Sessao[]

  @@index([epocaId, escalaoId])
  @@index([clubeId])
}

// Configuração de UM dia da semana. É o BASELINE (hora/local/tipo) usado na
// GERAÇÃO e na PROPAGAÇÃO: editar o baseline propaga a "esta e todas as futuras".
model PlanoSemanalDia {
  id             String     @id @default(cuid())
  planoSemanalId String
  diaSemana      Int // ISO-8601: 1=segunda … 7=domingo
  horaInicio     String // "HH:MM" (hora local)
  horaFim        String // "HH:MM" (> horaInicio)
  local          String?
  tipoSessao     TipoSessao @default(NORMAL)

  planoSemanal PlanoSemanal @relation(fields: [planoSemanalId], references: [id], onDelete: Cascade)
  sessoes      Sessao[]

  @@unique([planoSemanalId, diaSemana])
  @@index([planoSemanalId])
}

// ─────────────────────────────────────────────
// SESSÕES DE TREINO
// ─────────────────────────────────────────────

model Sessao {
  id                  String           @id @default(cuid())
  data                DateTime
  duracaoMin          Int?
  // P4.8 (§8.20): RPE da sessão atribuído pelo treinador (1-10). Multiplicado pela
  // duração dá a carga da sessão (sRPE); base do cálculo semanal de ACWR.
  rpeSessao           Int? // 1-10: carga percebida da sessão (RPE do treinador)
  objetivo            String?          @db.Text
  local               String?
  notas               String?          @db.Text
  microciclo          Int?
  mesociclo           Int?
  // §8.9.1 (decisão 2026-08-16) — posição do dia na semana no modo ESTRUTURADO (MD-X);
  // opcional, nunca bloqueia a sessão.
  momentoSemana       MomentoSemana?
  // 🔁 v7 (§3.5): null = herda a modalidade da secção do escalão; preenchido = atividade pontual noutra modalidade.
  modalidadeAtividade Modalidade?
  escalaoId           String
  escalao             Escalao          @relation(fields: [escalaoId], references: [id])
  epocaId             String
  epoca               Epoca            @relation(fields: [epocaId], references: [id])
  tipoSessao          TipoSessao       @default(NORMAL)
  planeamentoId       String?
  planeamento         Planeamento?     @relation(fields: [planeamentoId], references: [id])
  // §8.8.1 (Fase 31) — ligação ao plano semanal (null = treino avulso). SetNull:
  // apagar o plano não apaga as sessões (só as desvincula). `personalizada = true`
  // quando a sessão foi editada individualmente ("só esta"): a propagação
  // "esta e futuras" não sobrescreve os seus campos de agendamento.
  planoSemanalId      String?
  planoSemanalDiaId   String?
  personalizada       Boolean          @default(false)
  planoSemanal        PlanoSemanal?    @relation(fields: [planoSemanalId], references: [id], onDelete: SetNull)
  planoSemanalDia     PlanoSemanalDia? @relation(fields: [planoSemanalDiaId], references: [id], onDelete: SetNull)
  criadorId           String
  criador             Utilizador       @relation("SessaoCriador", fields: [criadorId], references: [id])
  criadoEm            DateTime         @default(now())
  atualizadoEm        DateTime         @updatedAt

  // F8 (§3.12): id do evento correspondente no Google Calendar (idempotência da sincronização).
  googleEventId String?

  exercicios     SessaoExercicio[]
  presencas      Presenca[]
  // P4.8 (§8.20): RPE individual reportado por cada atleta para esta sessão.
  rpesAtletas    RpeAtleta[]
  // Mano-a-Mano (§3.16): duelos 1×1 disputados no âmbito desta sessão de treino.
  duelosManoMano MatchManoMano[]

  @@index([epocaId, escalaoId, data])
  @@index([escalaoId])
  @@index([planeamentoId])
  @@index([data])
  @@index([planoSemanalDiaId])
  @@index([planoSemanalId])
}

// P4.8 (§8.20): RPE individual do atleta para uma sessão (1-10). Permite carga
// percebida por jogador; agregado (média) alimenta a carga semanal do escalão.
model RpeAtleta {
  id        String   @id @default(cuid())
  sessaoId  String
  sessao    Sessao   @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  atletaId  String
  atleta    Atleta   @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  rpe       Int // 1-10
  createdAt DateTime @default(now())

  @@unique([sessaoId, atletaId])
  @@index([atletaId])
  @@index([sessaoId])
}

model SessaoExercicio {
  id                String    @id @default(cuid())
  sessaoId          String
  sessao            Sessao    @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  exercicioId       String
  exercicio         Exercicio @relation(fields: [exercicioId], references: [id])
  ordem             Int       @default(0)
  duracaoMin        Int?
  notas             String?   @db.Text
  series            Int?
  descricaoOverride String?   @db.Text

  // Snapshot só-de-leitura (mecanismo em §4.2.1). Preenchido AUTOMATICAMENTE quando se
  // adiciona à sessão do clube um exercício com proprietario = TREINADOR: congela os dados
  // relevantes (nome, descrição, objetivo, diagrama) para que o CLUBE reconstrua o plano
  // histórico mesmo depois de o treinador (e o master editável) saírem. Imutável — não se
  // edita nem apaga. Exercícios proprietario = CLUBE não geram snapshot (já são do clube).
  // NOTA: snapDiagrama é Json? (cópia fiel do Exercicio.diagrama, um DiagramaCampo — §11),
  // conforme a bíblia §3.5.
  snapNome      String?
  snapDescricao String?   @db.Text
  snapObjetivo  String?   @db.Text
  snapDiagrama  Json?
  snapCriadoEm  DateTime?

  @@unique([sessaoId, ordem])
  @@index([sessaoId])
  @@index([exercicioId])
}

model Presenca {
  id           String         @id @default(cuid())
  sessaoId     String
  sessao       Sessao         @relation(fields: [sessaoId], references: [id], onDelete: Cascade)
  atletaId     String
  // P1.3 (RGPD): Cascade — o hard-delete do atleta apaga as suas presenças.
  atleta       Atleta         @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  // Escalão da presença (contract v6): analytics por escalão. Todos os registos preenchidos.
  escalaoId    String
  escalao      Escalao        @relation("PresencaEscalao", fields: [escalaoId], references: [id])
  estado       EstadoPresenca @default(PRESENTE)
  motivo       MotivoFalta?
  justificacao String?

  // Rastreio do autor da marcação (GAP-P2-15): quem registou/alterou a presença.
  // Nullable com SetNull — se o membro sair do clube, a presença preserva-se sem autor.
  marcadoPorId String?
  marcadoPor   MembroClube? @relation("PresencasMarcadas", fields: [marcadoPorId], references: [id], onDelete: SetNull)

  @@unique([sessaoId, atletaId])
  @@index([atletaId])
  @@index([escalaoId])
  @@index([escalaoId, estado])
  @@index([sessaoId, estado])
  @@index([marcadoPorId])
}

enum EstadoPresenca {
  PRESENTE
  FALTA
  FALTA_JUSTIFICADA
  LESIONADO
  ATRASADO
}

enum MotivoFalta {
  LESAO
  DOENCA
  OUTRO
  SEM_JUSTIFICACAO
}

enum TipoSessao {
  NORMAL
  ABERTO
  CAPTACAO
  EVENTO
}

// §8.9.1 — Posição do dia de treino na SEMANA (modo ESTRUTURADO), por relação com o dia de jogo
// (Match Day). MD_MENOS_* = dias antes do jogo · MD_MAIS_1 = dia seguinte (Recuperação) ·
// ATIVACAO/TAPER/LIVRE = dias sem referência direta ao jogo.
enum MomentoSemana {
  MD_MENOS_3
  MD_MENOS_2
  MD_MENOS_1
  MD_MAIS_1
  ATIVACAO
  TAPER
  LIVRE
}

// ─────────────────────────────────────────────
// JOGOS E ESTATÍSTICAS
// ─────────────────────────────────────────────

model Jogo {
  id                  String       @id @default(cuid())
  data                DateTime
  adversario          String
  casaFora            CasaFora     @default(CASA)
  tipo                TipoJogo     @default(OFICIAL)
  competicao          String? // texto livre (legado); preferir competicaoId
  competicaoId        String?
  competicaoRef       Competicao?  @relation(fields: [competicaoId], references: [id])
  golosMarcados       Int? // total da equipa (preenchido pós-jogo)
  golosSofridos       Int?
  faltas1aParte       Int? // faltas acumuladas da equipa por parte (futsal)
  faltas2aParte       Int?
  local               String?
  relatorio           String?      @db.Text
  videoUrl            String? // link YouTube (sem armazenamento)
  // 🔁 v7 (§3.7): FUTSAL_5 | FUTEBOL_* ; default derivado da secção do escalão.
  formato             FormatoJogo?
  // 🔁 v7 (§3.5/§3.7): null = herda a modalidade da secção; preenchido = atividade pontual noutra modalidade.
  modalidadeAtividade Modalidade?
  escalaoId           String
  escalao             Escalao      @relation(fields: [escalaoId], references: [id])
  epocaId             String
  epoca               Epoca        @relation(fields: [epocaId], references: [id])
  criadorId           String
  criador             Utilizador   @relation("JogoCriador", fields: [criadorId], references: [id])
  criadoEm            DateTime     @default(now())
  atualizadoEm        DateTime     @updatedAt

  // F8 (§3.12): id do evento correspondente no Google Calendar (idempotência da sincronização).
  googleEventId String?

  convocatorias Convocatoria[]
  estatisticas  EstatisticaAtleta[]
  quadros       QuadroTatico[]
  eventos       EventoJogo[]
  // F5 (M15): scouting contextualizado no jogo (dia de jogo).
  observacoes   ObservacaoAdversario[]

  @@index([epocaId, escalaoId, data])
  @@index([competicaoId])
  @@index([escalaoId])
  @@index([data])
}

enum CasaFora {
  CASA
  FORA
}

enum TipoJogo {
  OFICIAL
  AMIGAVEL
}

// 🔁 v7 (§3.7): formato de jogo (nº de jogadores por equipa). Deriva por defeito da
// modalidade da secção do escalão; guardado no jogo para o editor de campo e a
// interpretação das estatísticas. Ver Apêndice B para dimensões.
enum FormatoJogo {
  FUTSAL_5
  FUTEBOL_3_3
  FUTEBOL_5_5
  FUTEBOL_7
  FUTEBOL_9
  FUTEBOL_11
}

model Competicao {
  id          String            @id @default(cuid())
  clubeId     String
  // P1.5: FK explícita para o clube proprietário da competição.
  clube       Clube             @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  escalaoId   String
  escalao     Escalao           @relation(fields: [escalaoId], references: [id], onDelete: Cascade)
  epocaId     String
  epoca       Epoca             @relation(fields: [epocaId], references: [id], onDelete: Cascade)
  nome        String
  tipo        TipoJogo          @default(OFICIAL) // OFICIAL | AMIGAVEL
  // F6 (M16): formato da prova, para o cálculo da classificação (bíblia §3.7).
  formato     FormatoCompeticao @default(LIGA) // LIGA | TORNEIO | TACA
  // 🔁 v7 (§3.7): formato de jogo por defeito da competição (FUTSAL_5 | FUTEBOL_*).
  // NÃO confundir com `formato` (LIGA/TORNEIO/TACA).
  formatoJogo FormatoJogo?
  criadoEm    DateTime          @default(now())

  jogos Jogo[]

  // F6 (M16): resultados de todas as equipas, inseridos manualmente, para a classificação.
  resultados ResultadoCompeticao[]

  // Equipas participantes na competição (geração de quadro competitivo e agendamento).
  equipas EquipaCompeticao[]

  @@index([epocaId, escalaoId])
  @@index([clubeId])
  @@index([escalaoId])
}

// Formato da competição, determina como a classificação é apresentada (bíblia §3.7).
enum FormatoCompeticao {
  LIGA
  TORNEIO
  TACA
}

// Resultados dos jogos da competição, INSERIDOS MANUALMENTE pelo treinador (decisão 2026-08-05).
// O treinador insere os resultados de TODAS as equipas da competição para construir a classificação.
// Os jogos da própria equipa também podem alimentar a partir de `Jogo`. A tabela de classificação
// é CALCULADA (obterClassificacao), não armazenada. Sem integração automática na v1
// (integração com APIs de competições oficiais = FUTURO, bíblia §18).
model ResultadoCompeticao {
  id           String          @id @default(cuid())
  competicaoId String
  competicao   Competicao      @relation(fields: [competicaoId], references: [id], onDelete: Cascade)
  data         DateTime?
  equipaCasa   String
  equipaFora   String
  // Nullable: jogos agendados ainda não têm resultado.
  golosCasa    Int?
  golosFora    Int?
  // Jornada (LIGA) ou fase eliminatória (TORNEIO/TAÇA).
  ronda        Int?
  // Data e hora do jogo (null = por definir).
  dataHora     DateTime?
  // AGENDADO (sem resultado) | REALIZADO (com resultado).
  estado       EstadoResultado @default(AGENDADO)
  criadoEm     DateTime        @default(now())

  @@index([competicaoId])
}

// Estado de um jogo do quadro competitivo: agendado (sem resultado) ou realizado.
enum EstadoResultado {
  AGENDADO
  REALIZADO
}

// Equipa participante numa competição (base para a geração do quadro competitivo
// e o agendamento de jogos). O nome é único por competição.
model EquipaCompeticao {
  id           String   @id @default(cuid())
  competicaoId String
  nome         String
  posicao      Int?
  criadoEm     DateTime @default(now())

  competicao Competicao @relation(fields: [competicaoId], references: [id], onDelete: Cascade)

  @@unique([competicaoId, nome])
  @@index([competicaoId])
}

// Registo ao vivo (beira-campo). Agrega para as estatísticas.
model EventoJogo {
  id                 String         @id @default(cuid())
  jogoId             String
  jogo               Jogo           @relation(fields: [jogoId], references: [id], onDelete: Cascade)
  parte              Int // 1 | 2
  minuto             Int?
  tipo               TipoEventoJogo
  // F5 (M15): bloco de tempo associado (útil em substituições / tempos por blocos).
  bloco              BlocoTempo?
  atletaId           String?
  // P1.5: FK explícita. Cascade — apagar o atleta apaga os seus eventos de jogo.
  atleta             Atleta?        @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  atletaSecundarioId String?
  criadoEm           DateTime       @default(now())

  @@index([jogoId])
  @@index([atletaId])
}

enum TipoEventoJogo {
  GOLO
  ASSISTENCIA
  FALTA
  CARTAO_AMARELO
  CARTAO_VERMELHO
  SUBSTITUICAO
  DEFESA
  GOLO_SOFRIDO
  TIMEOUT
  // 🔁 v7 (§3.7): eventos de futebol 🥅.
  REMATE
  CANTO
  FORA_DE_JOGO
  DESARME
}

// Scouting do adversário (do clube).
model ObservacaoAdversario {
  id            String   @id @default(cuid())
  clubeId       String
  // P1.5: FK explícita para o clube proprietário da observação de scouting.
  clube         Clube    @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  escalaoId     String?
  // F5 (M15): scouting pode ser contextualizado num jogo (dia de jogo) ou avulso.
  jogoId        String?
  jogo          Jogo?    @relation(fields: [jogoId], references: [id], onDelete: SetNull)
  equipa        String
  jogoObservado String?
  competicao    String?
  sistemaTatico String?
  pontosFortes  String?  @db.Text
  pontosFracos  String?  @db.Text
  notas         String?  @db.Text
  diagrama      Json?
  criadoEm      DateTime @default(now())

  jogadores ObservacaoJogadorAdversario[]

  @@index([clubeId])
  @@index([jogoId])
}

model ObservacaoJogadorAdversario {
  id           String               @id @default(cuid())
  observacaoId String
  observacao   ObservacaoAdversario @relation(fields: [observacaoId], references: [id], onDelete: Cascade)
  numero       Int?
  nome         String?
  posicao      String?
  descricao    String?              @db.Text

  @@index([observacaoId])
}

model Convocatoria {
  id        String  @id @default(cuid())
  jogoId    String
  jogo      Jogo    @relation(fields: [jogoId], references: [id], onDelete: Cascade)
  atletaId  String
  // P1.3 (RGPD): Cascade — o hard-delete do atleta apaga as suas convocatórias.
  atleta    Atleta  @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  convocado Boolean @default(true)

  // F5 (M15): plano de dia de jogo — posição/titularidade prevista.
  posicaoPrevista Posicao?
  titularPrevisto Boolean  @default(false)

  @@unique([jogoId, atletaId])
  @@index([atletaId])
}

model EstatisticaAtleta {
  id       String @id @default(cuid())
  jogoId   String
  jogo     Jogo   @relation(fields: [jogoId], references: [id], onDelete: Cascade)
  atletaId String
  // P1.3 (RGPD): Cascade — o hard-delete do atleta apaga as suas estatísticas
  // (e, transitivamente, os ValorMetrica). O action bloqueia por defeito quando
  // existem estatísticas; a Cascade é a garantia ao nível do schema.
  atleta   Atleta @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  // Utilização (adaptado às rotações do futsal)
  utilizacao Utilizacao  @default(NAO_UTILIZADO)
  // F5 (M15): tempo de jogo por bloco pré-definido (alternativa/complemento a `minutos`).
  blocoTempo BlocoTempo?
  minutos    Int? // aproximado, opcional (derivável do bloco; null = não registado)

  // Métricas de jogador de campo
  golos        Int @default(0)
  assistencias Int @default(0)

  // Métricas de guarda-redes (só relevantes se posição = GR; null caso contrário)
  defesas         Int?
  golosSofridosGR Int? // golos sofridos com este GR em campo
  faltasCometidas Int? // opcional, útil em futsal (acumulação de faltas)

  // 🔁 v7 (§3.7): núcleo estatístico de FUTEBOL 🥅 (nullable; só em jogos de futebol).
  remates     Int?
  cantos      Int?
  forasDeJogo Int?
  desarmes    Int?

  // Disciplina (cartões)
  cartaoAmarelo  Int @default(0)
  cartaoVermelho Int @default(0)

  // Métricas configuráveis
  valoresMetricas ValorMetrica[]

  @@unique([jogoId, atletaId])
  @@index([atletaId])
}

enum Utilizacao {
  TITULAR
  UTILIZADO // entrou durante o jogo
  NAO_UTILIZADO // convocado mas não jogou
}

// F5 (M15): tempo de jogo por blocos pré-definidos (decisão 2026-08-05). NAO_JOGOU = 0.
enum BlocoTempo {
  JOGO_COMPLETO
  MEIA_PARTE
  BLOCO_10MIN
  BLOCO_5MIN
  NAO_JOGOU
}

// ─────────────────────────────────────────────
// MÉTRICAS CONFIGURÁVEIS
// ─────────────────────────────────────────────

model MetricaConfig {
  id         String      @id @default(cuid())
  nome       String
  tipo       TipoMetrica @default(NUMERO)
  ativa      Boolean     @default(true)
  ordem      Int         @default(0)
  // 🔁 v7 (§3.7): métrica pode ser específica de uma modalidade; null = ambas.
  modalidade Modalidade?
  clubeId    String
  clube      Clube       @relation(fields: [clubeId], references: [id])

  valores ValorMetrica[]

  @@index([clubeId])
}

enum TipoMetrica {
  NUMERO
  BOOLEANO
  ESCALA // 1 a 5
}

model ValorMetrica {
  id            String            @id @default(cuid())
  metricaId     String
  metrica       MetricaConfig     @relation(fields: [metricaId], references: [id], onDelete: Cascade)
  estatisticaId String
  estatistica   EstatisticaAtleta @relation(fields: [estatisticaId], references: [id], onDelete: Cascade)
  valor         Int

  @@unique([metricaId, estatisticaId])
  @@index([estatisticaId])
}

// ─────────────────────────────────────────────
// CADERNETA DE HABILIDADES
// ─────────────────────────────────────────────

model Habilidade {
  id         String          @id @default(cuid())
  nome       String // ex: "Vírgula", "Flip-flap", "Elástico"
  descricao  String?         @db.Text
  nivel      NivelHabilidade @default(BASICO)
  ordem      Int             @default(0)
  // 🔁 v7 (§3.8): habilidade pode ser específica de uma modalidade; null = ambas.
  modalidade Modalidade?
  clubeId    String
  clube      Clube           @relation(fields: [clubeId], references: [id])
  criadoEm   DateTime        @default(now())

  progressos ProgressoHabilidade[]

  @@index([clubeId])
}

enum NivelHabilidade {
  BASICO
  INTERMEDIO
  AVANCADO
}

model ProgressoHabilidade {
  id              String           @id @default(cuid())
  atletaId        String
  atleta          Atleta           @relation(fields: [atletaId], references: [id], onDelete: Cascade)
  habilidadeId    String
  habilidade      Habilidade       @relation(fields: [habilidadeId], references: [id])
  epocaId         String
  epoca           Epoca            @relation(fields: [epocaId], references: [id])
  estado          EstadoHabilidade @default(NAO_INICIADO)
  dataDesbloqueio DateTime?
  notas           String?

  @@unique([atletaId, habilidadeId, epocaId])
  @@index([atletaId, epocaId])
  @@index([habilidadeId])
}

enum EstadoHabilidade {
  NAO_INICIADO
  EM_PROGRESSO
  DESBLOQUEADO
}

// ─────────────────────────────────────────────
// RELATÓRIO DE ÉPOCA PARTILHÁVEL (F9 — bíblia §3.10, §8.15, §16 fase 19)
// ─────────────────────────────────────────────

// Link partilhável (público via token) de um relatório de época. Inclui identidade do clube.
// O `dadosSnapshot` guarda uma cópia IMUTÁVEL dos dados no momento de gerar (bíblia §10.6):
// o link continua a mostrar o que existia quando foi criado, mesmo que os dados mudem depois.
model RelatorioPartilhado {
  id            String        @id @default(cuid())
  clubeId       String
  token         String        @unique // segmento de URL não-adivinhável
  tipo          TipoRelatorio // EPOCA_ATLETA | EPOCA_EQUIPA | EPOCA_CLUBE
  epocaId       String
  escalaoId     String? // p/ EPOCA_EQUIPA
  atletaId      String? // p/ EPOCA_ATLETA
  dadosSnapshot Json? // snapshot dos dados no momento de gerar (imutável)
  expiraEm      DateTime?
  criadorId     String
  criadoEm      DateTime      @default(now())

  @@index([clubeId])
}

enum TipoRelatorio {
  EPOCA_ATLETA
  EPOCA_EQUIPA
  EPOCA_CLUBE
}

// ─────────────────────────────────────────────
// F8 — INTEGRAÇÃO COM CALENDÁRIO EXTERNO (Google Calendar, §3.12)
// ─────────────────────────────────────────────

// Integração de terceiros (Google Calendar), DISTINTA do login/autenticação da app.
// Sincroniza treinos, jogos e reuniões. Guarda tokens OAuth do Google por utilizador.
model IntegracaoCalendario {
  id           String     @id @default(cuid())
  utilizadorId String     @unique
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  provedor     String     @default("google")
  refreshToken String // encriptado at-rest
  calendarioId String? // calendário destino
  ativa        Boolean    @default(true)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
}

// ─────────────────────────────────────────────
// F11 — LICENCIAMENTO, SUBSCRIÇÃO E CARTEIRA (§3.11)
// ─────────────────────────────────────────────

// Modelo desenhado para suportar a integração futura com Paddle (Merchant of Record).
// O enforcement de licença (bloqueio pós-expiração) e o billing são DEFERIDOS; a
// arquitetura de dados fica pronta.
//
// Licença ativa de um utilizador (Individual) OU de um clube (Clube).
// Um titular tem no máximo uma ativa (utilizadorId @unique OU clubeId @unique).
model Licenca {
  id            String         @id @default(cuid())
  tipo          TipoLicenca // INDIVIDUAL | CLUBE
  tier          TierClube? // só se tipo=CLUBE: PEQUENO | MEDIO | GRANDE | PARCEIRO
  estado        EstadoLicenca  @default(ATIVA) // ATIVA | EXPIRADA | CANCELADA | SUSPENSA
  ciclo         CicloFaturacao // MENSAL | ANUAL
  precoCentimos Int? // preço praticado (cêntimos) — já com acréscimo multi-secção

  // 🔁 v7 (§3.11/§17.1) — Individual: modalidade contratada (futsal ou futebol). null em licenças de Clube.
  modalidade Modalidade? // registo explícito do produto Individual vendido
  // 🔁 v7 (§3.11/§17.1) — Clube: nº de secções faturadas (pricing: tier mais caro + 50%/secção adicional).
  numSeccoes Int         @default(1) // 1 = comportamento v6; >1 aplica acréscimo por secção adicional

  // Titular (exatamente um dos dois preenchido)
  utilizadorId String?     @unique
  utilizador   Utilizador? @relation("LicencaIndividual", fields: [utilizadorId], references: [id])
  clubeId      String?     @unique
  clube        Clube?      @relation("LicencaClube", fields: [clubeId], references: [id])

  // Datas
  dataInicio    DateTime  @default(now())
  dataRenovacao DateTime?
  dataFim       DateTime?

  // Integração Paddle (futura)
  paddleSubscriptionId String?
  paddleCustomerId     String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

enum TipoLicenca {
  INDIVIDUAL
  CLUBE
}

enum TierClube {
  PEQUENO
  MEDIO
  GRANDE
  PARCEIRO
}

enum EstadoLicenca {
  ATIVA
  EXPIRADA
  CANCELADA
  SUSPENSA
  PENDENTE // plano escolhido no onboarding, ainda por pagar/ativar (§8.1 / §17.1)
}

enum CicloFaturacao {
  MENSAL
  ANUAL
}

// Carteira (wallet) do treinador — crédito de absorção usado em compras futuras.
model Carteira {
  id            String     @id @default(cuid())
  utilizadorId  String     @unique
  utilizador    Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  saldoCentimos Int        @default(0)
  atualizadoEm  DateTime   @updatedAt

  movimentos MovimentoCarteira[]
}

model MovimentoCarteira {
  id            String        @id @default(cuid())
  carteiraId    String
  carteira      Carteira      @relation(fields: [carteiraId], references: [id], onDelete: Cascade)
  tipo          TipoMovimento // CREDITO_ABSORCAO | DEBITO_COMPRA | REEMBOLSO | AJUSTE
  valorCentimos Int // positivo = crédito; negativo = débito
  descricao     String
  criadoEm      DateTime      @default(now())

  @@index([carteiraId])
}

enum TipoMovimento {
  CREDITO_ABSORCAO
  DEBITO_COMPRA
  REEMBOLSO
  AJUSTE
}

// ─────────────────────────────────────────────
// P2.1 — LEMBRETES / TAREFAS DE EQUIPA (§3.15/§8.19)
// ─────────────────────────────────────────────

// Lembrete/tarefa persistido, criado por um utilizador e opcionalmente dirigido
// a um conjunto de destinatários (membros do clube). Distinto dos "lembretes de
// hoje" derivados no dashboard (lib/dashboard-lembretes.ts), que são efémeros.
//
// NOTA de modelação: o campo `criadoPor` referencia `Utilizador` (a pessoa), não
// `Perfil` — no Mister o `Perfil` é um pacote de capacidades (papel), pelo
// que criador e destinatário têm de ser pessoas para que o estado `visto` e o
// filtro "criados por mim / onde sou destinatário" façam sentido.
model Lembrete {
  id          String     @id @default(cuid())
  clubeId     String
  clube       Clube      @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  criadoPorId String
  criadoPor   Utilizador @relation("LembreteCriadoPor", fields: [criadoPorId], references: [id], onDelete: Cascade)
  titulo      String
  descricao   String?
  dataLimite  DateTime?
  concluido   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  destinatarios LembreteDestinatario[]

  @@index([clubeId])
  @@index([criadoPorId])
}

// Destinatário de um lembrete + estado de leitura (`visto`) por pessoa.
model LembreteDestinatario {
  id           String     @id @default(cuid())
  lembreteId   String
  lembrete     Lembrete   @relation(fields: [lembreteId], references: [id], onDelete: Cascade)
  utilizadorId String
  utilizador   Utilizador @relation("LembreteDestinatario", fields: [utilizadorId], references: [id], onDelete: Cascade)
  visto        Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([lembreteId, utilizadorId])
  @@index([utilizadorId])
}

// Token de recuperação de password (§6.2). De vida curta (expira em 1h), de uso
// único e sem relação com o Utilizador — a associação é apenas por `email`, para
// não expor a existência da conta. Os tokens são apagados após uso e a cada novo
// pedido do mesmo email.
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  criadoEm  DateTime @default(now())

  @@index([email])
  @@index([token])
}

// ─────────────────────────────────────────────
// MANO-A-MANO — DUELOS 1×1 (§3.16)
// ─────────────────────────────────────────────

// Liga anual (todos-contra-todos ao longo da época) ou torneio pontual.
enum TipoManoMano {
  LIGA_ANUAL
  TORNEIO
}

// Âmbito dos participantes: só atletas do clube, ou também atletas/clubes externos.
enum AmbitoManoMano {
  INTRA_CLUBE
  INTER_CLUBES
}

// Formato do quadro competitivo de um torneio Mano-a-Mano.
enum FormatoTorneioManoMano {
  ELIMINATORIO
  ROUND_ROBIN
}

// Formato de cada duelo individual.
enum FormatoDuelo {
  PRIMEIRO_A_DOIS
  MELHOR_DE_2_JOGOS
  TEMPO_LIMITE
}

// Estado do ciclo de vida de uma competição Mano-a-Mano.
enum EstadoManoMano {
  ATIVA
  CONCLUIDA
  ARQUIVADA
}

// Estado de um duelo (match) individual.
enum EstadoMatch {
  AGENDADO
  REALIZADO
  ADIADO
  ANULADO
}

// Natureza de um participante: atleta do sistema ou externo (texto livre / clube externo).
enum TipoParticipante {
  ATLETA
  EXTERNO
}

// Clube adversário externo (fora do sistema), criado por um clube para registar
// participantes externos em competições Mano-a-Mano de âmbito INTER_CLUBES.
model ClubeExterno {
  id               String  @id @default(cuid())
  nome             String
  localidade       String?
  criadoPorClubeId String
  criadoPorClube   Clube   @relation(fields: [criadoPorClubeId], references: [id], onDelete: Cascade)

  participantes ParticipanteManoMano[]

  criadoEm DateTime @default(now())

  @@index([criadoPorClubeId])
}

// Competição de duelos 1×1: liga anual ou torneio. Scoped ao clube/época e,
// opcionalmente, a um escalão. Reúne participantes e matches (§3.16).
model CompeticaoManoMano {
  id        String   @id @default(cuid())
  clubeId   String
  clube     Clube    @relation(fields: [clubeId], references: [id], onDelete: Cascade)
  epocaId   String
  epoca     Epoca    @relation(fields: [epocaId], references: [id], onDelete: Cascade)
  escalaoId String?
  escalao   Escalao? @relation(fields: [escalaoId], references: [id], onDelete: SetNull)

  nome   String
  tipo   TipoManoMano
  ambito AmbitoManoMano @default(INTRA_CLUBE)

  // Só relevante quando tipo = TORNEIO.
  formatoTorneio FormatoTorneioManoMano?

  formatoDuelo     FormatoDuelo @default(PRIMEIRO_A_DOIS)
  golosParaVencer  Int          @default(2)
  // Só relevante quando formatoDuelo = TEMPO_LIMITE.
  duracaoLimiteMin Int?

  pontosVitoria Int @default(3)
  pontosEmpate  Int @default(1)
  pontosDerrota Int @default(0)

  // Ordem/config de critérios de desempate (ex: ["confronto_direto","diferenca_golos"]).
  criteriosDesempate Json?

  // Integra os duelos no fluxo de treinos (agendáveis dentro de sessões).
  integraTreinos Boolean @default(false)

  estado EstadoManoMano @default(ATIVA)

  criadorId String
  criador   Utilizador @relation(fields: [criadorId], references: [id])

  participantes ParticipanteManoMano[]
  matches       MatchManoMano[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([clubeId])
  @@index([epocaId, escalaoId])
}

// Participante numa competição Mano-a-Mano: atleta do sistema ou participante externo.
model ParticipanteManoMano {
  id           String             @id @default(cuid())
  competicaoId String
  competicao   CompeticaoManoMano @relation(fields: [competicaoId], references: [id], onDelete: Cascade)

  tipo TipoParticipante

  // Preenchido quando tipo = ATLETA.
  atletaId String?
  atleta   Atleta? @relation(fields: [atletaId], references: [id], onDelete: Cascade)

  // Preenchidos quando tipo = EXTERNO.
  atletaExternoNome String?
  clubeExternoId    String?
  clubeExterno      ClubeExterno? @relation(fields: [clubeExternoId], references: [id], onDelete: SetNull)

  seed  Int?
  ativo Boolean @default(true)

  matchesA        MatchManoMano[] @relation("MatchParticipanteA")
  matchesB        MatchManoMano[] @relation("MatchParticipanteB")
  matchesVencidos MatchManoMano[] @relation("MatchVencedor")

  @@unique([competicaoId, atletaId])
  @@index([competicaoId])
  @@index([atletaId])
}

// Duelo individual (match) entre dois participantes. Suporta liga (ronda/jornada)
// e torneio eliminatório (bracket via proximoMatch). Pode ser disputado no âmbito
// de uma sessão de treino (§3.16).
model MatchManoMano {
  id           String             @id @default(cuid())
  competicaoId String
  competicao   CompeticaoManoMano @relation(fields: [competicaoId], references: [id], onDelete: Cascade)

  participanteAId String?
  participanteA   ParticipanteManoMano? @relation("MatchParticipanteA", fields: [participanteAId], references: [id], onDelete: SetNull)
  participanteBId String?
  participanteB   ParticipanteManoMano? @relation("MatchParticipanteB", fields: [participanteBId], references: [id], onDelete: SetNull)

  ronda        Int?
  ordemNaRonda Int?

  // Bracket de eliminatória: chave da posição e progressão para o match seguinte.
  chaveBracket      String?
  proximoMatchId    String?
  proximoMatch      MatchManoMano?  @relation("BracketProgression", fields: [proximoMatchId], references: [id], onDelete: SetNull)
  matchesAnteriores MatchManoMano[] @relation("BracketProgression")

  data     DateTime?
  local    String?
  sessaoId String?
  sessao   Sessao?   @relation(fields: [sessaoId], references: [id], onDelete: SetNull)

  estado EstadoMatch @default(AGENDADO)

  golosA Int?
  golosB Int?

  vencedorParticipanteId String?
  vencedor               ParticipanteManoMano? @relation("MatchVencedor", fields: [vencedorParticipanteId], references: [id], onDelete: SetNull)
  empate                 Boolean               @default(false)

  registadoPorId String?
  registadoPor   MembroClube? @relation(fields: [registadoPorId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([competicaoId])
  @@index([sessaoId])
  @@index([estado])
  @@index([competicaoId, ronda])
}
