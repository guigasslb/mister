# Base de dados PostgreSQL (Supabase)
# DATABASE_URL: connection pooling (Transaction, porta 6543, com ?pgbouncer=true) — usado pela app
# DIRECT_URL: ligação direta (porta 5432) — usado pelas migrações Prisma
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Segredo do Auth.js — gerar com: npx auth secret
AUTH_SECRET=""

# Necessário se a app corre atrás de proxy e o host não é auto-detetado
# (ex.: alguns self-hosts). No Vercel é detetado automaticamente.
# AUTH_TRUST_HOST="true"

# (Opcional em dev; OBRIGATÓRIO em produção — o seed falha sem estas.)
# Passwords iniciais do seed. Sem elas em dev, usa "futsal2026".
SEED_PASS_GONCALO=""
SEED_PASS_ADJUNTO=""

# Password do utilizador admin de plataforma (admin@mister.app) criado pelo seed.
# Sem esta em dev, usa a default definida no seed.
SEED_PASS_ADMIN=""

# URL base pública da app — usada para compor o redirect_uri do callback OAuth
# do Google Calendar (${NEXTAUTH_URL}/api/google/callback). No Vercel usa a URL
# do deployment. Ex.: https://app.mister.pt
NEXTAUTH_URL=""

# ─── Backoffice de plataforma (/admin) ───────────────────────────────────────
# Allowlist de emails com acesso ao backoffice interno do produto Mister, SEPARADA
# de qualquer papel de clube. Lista separada por vírgulas (case-insensitive).
# Vazio/ausente = ninguém tem acesso ao /admin. Ex.: admin@mister.app,ops@mister.pt
# (o seed cria o utilizador admin@mister.app; para lhe dar acesso ao /admin,
# inclui-o aqui.)
ADMIN_EMAILS=""

# ─── Integração Google Calendar (F8, §3.12) — OPCIONAL ───────────────────────
# Integração de TERCEIROS, distinta do login/autenticação da app. Se ausente, a
# funcionalidade desliga-se de forma controlada (as actions devolvem erro claro,
# sem crash). Credenciais OAuth obtidas na Google Cloud Console (tipo "Web").
# O redirect_uri autorizado tem de ser ${NEXTAUTH_URL}/api/google/callback.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Chave de encriptação at-rest do refresh token do Google (AES-256-GCM).
# Hexadecimal de 64 caracteres (32 bytes). Gerar com:
#   openssl rand -hex 32
# Sem esta chave em dev, o token é guardado em Base64 (NÃO SEGURO) com aviso.
# OBRIGATÓRIA em produção: a app não arranca sem ela (erro explícito).
ENCRYPTION_KEY=gera_com_openssl_rand_-hex_32

# IBAN para pagamento de licenças (mostrado na página /sem-licenca)
NEXT_PUBLIC_IBAN=""

# ─── Envio de email transacional (§6.2 — recuperação de password) ────────────
# Distinto do login/autenticação. Usado para enviar o link de reposição de
# password. A app escolhe o transporte pela ordem: Resend > SMTP > (dev) log.
#
# Opção A — Resend (API HTTP, recomendado em serverless/Vercel). Se definido,
# tem prioridade sobre o SMTP. Obtém a chave em https://resend.com.
RESEND_API_KEY=""
#
# Opção B — SMTP genérico (nodemailer). Usado se RESEND_API_KEY estiver vazio.
# EMAIL_PORT=465 → TLS implícito; 587/25 → STARTTLS.
EMAIL_HOST=""
EMAIL_PORT="587"
EMAIL_USER=""
EMAIL_PASS=""
#
# Remetente mostrado ao destinatário (ambas as opções). Ex.: "Mister <no-reply@mister.app>".
# Sem esta variável usa-se um fallback interno.
EMAIL_FROM=""
#
# NOTA: sem RESEND_API_KEY nem EMAIL_HOST, em desenvolvimento o email é apenas
# impresso no log do servidor (não falha); em produção o envio lança erro.
# O link de reposição é composto a partir de NEXTAUTH_URL (ver acima).
